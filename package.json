{
  "name": "annas-portfolio-v2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3200",
    "preview": "node scripts/preview.mjs",
    "format": "prettier --write src scripts tests next.config.ts",
    "build": "node scripts/sync-github.mjs && next build",
    "postbuild": "node scripts/finish-export.mjs",
    "lint": "eslint src scripts tests next.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "check:export": "node scripts/check-export.mjs",
    "check:repo": "node scripts/check-repository.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "embla-carousel-react": "8.6.0",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "yet-another-react-lightbox": "3.32.2"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "prettier": "^3.9.10",
    "typescript": "^5"
  }
}
